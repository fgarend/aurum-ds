# LF line endings for every text file, whatever the platform.
# Binary types and third-party folders are added in the commits that bring them.
* text=auto eol=lf

# The frozen snapshot of the artifact: third-party code, kept byte for byte.
reference/artifact/** linguist-vendored -text

# What make build writes, kept so the app can install any commit: GitHub folds it in diffs (decision 0063).
dist/** linguist-generated
