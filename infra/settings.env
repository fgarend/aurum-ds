# Settings of the containers (decision 0043), read by Compose. Versioned: it never holds a secret.
# A value given on the command line wins for that run only, such as NODE_IMAGE=… make test.

# The images the environment starts from, pinned by tag and digest. make outdated reports newer ones.
NODE_IMAGE=node:26.12.1-trixie-slim@sha256:94816674c62774da0d099a947bf4613b9e1972a2733abd0d0cd80e795f8411d0
PNPM_IMAGE=ghcr.io/pnpm/pnpm:12.15.0@sha256:d6148daf3ad2af8fa4ecd1aa06db73da32b2e37f63088987eea2fb375ee7f320

# The port make prototype serves the prototype's screens on, at http://localhost:<port>.
PROTOTYPE_PORT=5173
