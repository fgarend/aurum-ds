# Settings of the containers (decision 0043), read by Compose. Versioned: it never holds a secret.
# A value given on the command line wins for that run only, such as PLAYWRIGHT_IMAGE=… make check.

# The images the environment starts from, pinned by tag and digest. make outdated reports newer ones. Playwright's
# brings Node and the browsers, at the version of the playwright package (decision 0047).
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.64.1-noble@sha256:2f05f8a734509a7b3f26a912639488ee08f58a7b292d14d62271bcff9038768f
PNPM_IMAGE=ghcr.io/pnpm/pnpm:12.16.0@sha256:bad10c413974ba79d74d2c0ed4d87e1da4677e498512f8b00031b012c24c82f6

# The port make prototype serves the prototype's screens on, at http://localhost:<port>.
PROTOTYPE_PORT=5173

# The port make storybook serves the gallery of components on, at http://localhost:<port> (decision 0057).
STORYBOOK_PORT=6006
