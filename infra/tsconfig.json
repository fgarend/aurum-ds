// TypeScript settings for the repository's scripts, which run on Node (decision 0018).
{
  "extends": "../tsconfig.json",
  "include": ["."],
  "compilerOptions": {
    // Node's APIs. The DOM is there only because Vitest's configuration types, with the browser provider, name DOM
    // types; these scripts never run in a browser.
    "lib": ["es2023", "dom"],
    "types": ["node", "vite/client"]
  }
}
