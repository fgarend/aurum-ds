{
  "name": "@fgarend/aurum-ds",
  "version": "0.0.0",
  "private": true,
  "description": "A quiet design system for money interfaces.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgarend/aurum-ds.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "lint": "biome ci --error-on-warnings",
    "types": "tsc && tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json",
    "test": "vitest run --project node --project dom",
    "test-repository": "vitest run --project repository",
    "test-browser": "vitest run --project browser",
    "pack": "node scripts/check-package.ts /pnpm-store",
    "format": "biome check --write",
    "tokens": "node scripts/build-tokens/main.ts",
    "watch": "vitest --project node --project dom",
    "screenshots": "node scripts/update-screenshots.ts",
    "reference": "vitest run --project reference",
    "prototype": "vite reference/prototype --host 0.0.0.0 --port \"$PROTOTYPE_PORT\" --strictPort",
    "outdated-deps": "pnpm outdated",
    "outdated-pins": "node scripts/check-pins.ts",
    "audit": "pnpm audit"
  },
  "exports": {
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts.css": "./src/fonts/fonts.css",
    "./base.css": "./src/styles/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src/tokens/tokens.css",
    "src/fonts/fonts.css",
    "src/styles/base.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  }
}
