{
  "name": "@fgarend/aurum-ds",
  "version": "0.1.1",
  "private": true,
  "description": "A quiet design system for money interfaces.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgarend/aurum-ds.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "lint": "biome ci --error-on-warnings",
    "types": "tsc && tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json",
    "test": "vitest run --project node",
    "test-repository": "vitest run --project repository",
    "test-browser": "vitest run --project browser --project visual --project storybook",
    "coverage": "vitest run --coverage --project node --project browser --project storybook --project visual",
    "pack": "node scripts/check-package.ts /pnpm-store",
    "check-release": "node scripts/check-release.ts",
    "release-notes": "node scripts/extract-release-notes.ts",
    "release-package": "pnpm pack --pack-destination /tmp/package >&2 && cat /tmp/package/*.tgz",
    "format": "biome check --write",
    "tokens": "node scripts/build-tokens/main.ts",
    "watch": "vitest --project node --project browser --browser.name=chromium",
    "screenshots": "node scripts/update-screenshots.ts",
    "reference": "vitest run --project reference",
    "prototype": "vite reference/prototype --host 0.0.0.0 --port \"$PROTOTYPE_PORT\" --strictPort",
    "storybook": "storybook dev --host 0.0.0.0 --port \"$STORYBOOK_PORT\" --no-open --ci",
    "outdated-deps": "pnpm outdated",
    "outdated-pins": "node scripts/check-pins/main.ts",
    "audit": "pnpm audit"
  },
  "exports": {
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts.css": "./src/fonts/fonts.css",
    "./base.css": "./src/styles/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src/tokens/tokens.css",
    "src/fonts/fonts.css",
    "src/styles/base.css"
  ],
  "peerDependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "lucide-react": "1.62.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  }
}
