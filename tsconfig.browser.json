// TypeScript settings for the browser tests (decisions 0032 and 0052). They need Vite's client types and a Node type
// that Vitest's browser types name, which the library's code must never see, so they are checked apart.
{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.browser.test.ts",
    "src/**/*.browser.test.tsx",
    "src/**/*.visual.test.ts",
    "src/**/*.visual.test.tsx"
  ],
  "exclude": [],
  "compilerOptions": {
    // Vite's client types declare the CSS files the tests import, and Vitest's browser types name a Node type.
    "types": ["vite/client", "node"]
  }
}
