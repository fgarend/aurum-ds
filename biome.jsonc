// Lint and format settings (decision 0016).
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // What .gitignore lists is left out.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // The frozen snapshot is never edited, pnpm writes its own lockfile, and make tokens writes tokens.css.
    "includes": [
      "**",
      "!reference",
      "!pnpm-lock.yaml",
      "!src/tokens/tokens.css"
    ]
  },
  // Biome's default style, with the indentation from .editorconfig.
  "formatter": { "useEditorconfig": true },
  "markdown": { "formatter": { "enabled": true } },
  "linter": {
    // Rules for frameworks and libraries this repository does not use. A domain is turned back on
    // by the roadmap item that brings its tool in.
    "domains": {
      "astro": "none",
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "qwik": "none",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "tanstackQuery": "none",
      "turborepo": "none",
      "vue": "none"
    },
    "rules": {
      // Every stable rule. Each one turned off or adjusted says why.
      "preset": "all",
      "style": {
        // Choosing between two values, as in JSX, reads best as a ternary. noNestedTernary stays on.
        "noTernary": "off"
      },
      "performance": {
        // It allows a handler declared in the component, which changes identity just the same, and it
        // flags handlers on DOM elements, where identity does not matter. Memoization is a convention.
        "noJsxPropsBind": "off"
      },
      "complexity": {
        // noPropertyAccessFromIndexSignature asks for brackets on keys that may be missing (decision 0013).
        "useLiteralKeys": "off"
      },
      "suspicious": {
        // Biome does not see that noUncheckedIndexedAccess makes an indexed read possibly undefined
        // (decision 0013), so it would flag the very checks that handle it.
        "noUnnecessaryConditions": "off"
      },
      "correctness": {
        // Node's module rules ask for .js in relative imports of TypeScript (decision 0013). Mapping only .ts and
        // .tsx leaves CSS imports alone, which forceJsExtensions would turn into .js.
        "useImportExtensions": {
          "level": "on",
          "options": { "extensionMappings": { "ts": "js", "tsx": "js" } }
        }
      }
    }
  },
  "overrides": [
    {
      // A test takes a component's stories as one module, as Storybook composes them; tests and Storybook's settings
      // never reach the app's bundle (decision 0057).
      "includes": ["**/*.test.tsx", ".storybook/**"],
      "linter": { "rules": { "performance": { "noNamespaceImport": "off" } } }
    },
    {
      // A component's file exports its props type beside it (decision 0054). The rule guards Fast Refresh, which a
      // type does not affect, since TypeScript erases it.
      "includes": ["src/components/**"],
      "linter": {
        "rules": { "style": { "useComponentExportOnlyModules": "off" } }
      }
    },
    {
      // The package's public entry only re-exports. Revisited with the component conventions.
      "includes": ["src/index.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      // In a test, a long function is a describe block grouping short cases, text in JSX is test data,
      // and a component declared only for the test is never hot reloaded.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" },
          "style": {
            "noJsxLiterals": "off",
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // Vitest reads its configuration, Storybook its settings and each component's stories from a default export.
      "includes": ["vitest.config.ts", ".storybook/**", "**/*.stories.tsx"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // The repository's scripts and test settings run on Node: they read files, print and set the exit code. Node
      // runs them as they are, so they import each other by their .ts names (decision 0044).
      "includes": ["scripts/**", "test/**", "vitest.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off",
            "useImportExtensions": {
              "level": "on",
              "options": { "extensionMappings": {} }
            }
          },
          "suspicious": { "noConsole": "off" }
        }
      }
    }
  ]
}
