// TypeScript settings (decision 0013). Only types are checked: the build decides what is emitted.
{
  // The setup of the component tests, and its own test, are checked with the library, whose tests use its matchers.
  "include": ["src", "test/dom-setup.ts", "test/dom-setup.test.tsx"],
  // The browser tests have their own settings, in tsconfig.browser.json (decision 0032).
  "exclude": [
    "src/**/*.browser.test.ts",
    "src/**/*.browser.test.tsx",
    "src/**/*.visual.test.ts",
    "src/**/*.visual.test.tsx"
  ],
  "compilerOptions": {
    "noEmit": true,

    // Node's module rules, the strictest: code that passes works in Node and in bundlers.
    "module": "nodenext",

    // Only what Baseline lists as widely available, in the browser.
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "types": [],

    // React's automatic JSX runtime: no React import in each file.
    "jsx": "react-jsx",

    // Every check TypeScript offers.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    // Required by isolatedDeclarations. Nothing is emitted.
    "declaration": true
  }
}
